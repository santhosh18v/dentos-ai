generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DENTIST
  RECEPTIONIST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Clinic {
  id           String        @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  gstNumber    String?
  logoUrl      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  patients     Patient[]
  appointments Appointment[]
}

model User {
  id            String         @id @default(cuid())
  clinicId      String
  name          String
  email         String         @unique
  passwordHash  String
  role          Role
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  refreshTokens RefreshToken[]
  appointments  Appointment[]  @relation("DentistAppointments")

  @@index([clinicId])
  @@index([email])
  @@index([clinicId, role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Patient {
  id                String        @id @default(cuid())
  clinicId          String
  patientCode       String
  name              String
  phone             String
  email             String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  medicalHistory    String?
  allergies         String?
  bloodGroup        String?
  emergencyContact  String?
  preferredLanguage String        @default("ENGLISH")
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  clinic            Clinic        @relation(fields: [clinicId], references: [id])
  appointments      Appointment[]

  @@unique([clinicId, patientCode])
  @@index([clinicId])
  @@index([phone])
}

model Appointment {
  id            String            @id @default(cuid())
  clinicId      String
  patientId     String
  dentistId     String
  scheduledAt   DateTime
  durationMins  Int               @default(30)
  treatmentType String
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  dentist User    @relation("DentistAppointments", fields: [dentistId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([dentistId])
  @@index([scheduledAt])
}