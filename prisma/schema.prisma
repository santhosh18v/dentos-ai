generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DENTIST
  RECEPTIONIST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  NEEDS_FOLLOWUP
}

enum CallStatus {
  INITIATED
  RINGING
  ANSWERED
  COMPLETED
  NO_ANSWER
  FAILED
}

enum CallIntent {
  CONFIRM
  CANNOT_ATTEND
  CALL_ME_BACK
  HUMAN_ASSISTANCE
  REPEAT
}

model Clinic {
  id            String         @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  gstNumber     String?
  logoUrl       String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  patients      Patient[]
  appointments  Appointment[]
  callLogs      CallLog[]
  clinicalNotes ClinicalNote[]
}

model User {
  id            String         @id @default(cuid())
  clinicId      String
  name          String
  email         String         @unique
  passwordHash  String
  role          Role
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  refreshTokens RefreshToken[]
  appointments  Appointment[]  @relation("DentistAppointments")
  clinicalNotes ClinicalNote[] @relation("DentistNotes")

  @@index([clinicId])
  @@index([email])
  @@index([clinicId, role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Patient {
  id                String         @id @default(cuid())
  clinicId          String
  patientCode       String
  name              String
  phone             String
  email             String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  medicalHistory    String?
  allergies         String?
  bloodGroup        String?
  emergencyContact  String?
  preferredLanguage String         @default("ENGLISH")
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  clinic            Clinic         @relation(fields: [clinicId], references: [id])
  appointments      Appointment[]
  callLogs          CallLog[]
  clinicalNotes     ClinicalNote[]

  @@unique([clinicId, patientCode])
  @@index([clinicId])
  @@index([phone])
}

model Appointment {
  id            String            @id @default(cuid())
  clinicId      String
  patientId     String
  dentistId     String
  scheduledAt   DateTime
  durationMins  Int               @default(30)
  treatmentType String
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  dentist       User           @relation("DentistAppointments", fields: [dentistId], references: [id])
  callLogs      CallLog[]
  clinicalNotes ClinicalNote[]

  @@index([clinicId])
  @@index([patientId])
  @@index([dentistId])
  @@index([scheduledAt])
}

model CallLog {
  id            String      @id @default(cuid())
  clinicId      String
  appointmentId String
  patientId     String
  phoneNumber   String
  status        CallStatus  @default(INITIATED)
  intent        CallIntent?
  reason        String?
  transcript    String?
  durationSecs  Int?
  needsFollowup Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([status])
}

model ClinicalNote {
  id               String    @id @default(cuid())
  clinicId         String
  appointmentId    String
  patientId        String
  dentistId        String
  chiefComplaint   String?
  clinicalFindings String?
  assessment       String?
  treatmentPlan    String?
  treatmentDone    String?
  prescription     String?
  followUpDate     DateTime?
  rawTranscript    String?
  aiGenerated      Boolean   @default(false)
  isApproved       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  dentist     User        @relation("DentistNotes", fields: [dentistId], references: [id])

  @@index([clinicId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([dentistId])
  @@index([isApproved])
}
